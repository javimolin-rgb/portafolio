---
import Base from '../layouts/Base.astro';
import { url } from '../lib/assets';
---
<Base title="Página no encontrada — Javi Molin" description="Esta página no existe.">
  <section class="nf page-head">
    <h1 class="nf__t display">Fuera de formato</h1>
    <p class="lead">Esta página no existe o cambió de lugar.</p>
    <div class="actions"><a class="btn" href={url('')}>Volver al inicio</a><a class="btn btn--ghost" href={url('proyectos/')}>Ver proyectos</a></div>
  </section>
</Base>
<style>
  .nf { display: grid; gap: var(--s-5); }
  .nf__t { font-size: var(--t-display); }
</style>
