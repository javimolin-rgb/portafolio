---
/* Lámina de contactos de fondos de pantalla. Cada fondo es un SVG en public/, cargado en diferido. */
import type { Fondo } from '../data/biblioteca-muralia';
import { url } from '../lib/assets';

interface Props { fondos: Fondo[]; dir: string; line?: string }
const { fondos, dir, line = '#e4e4e0' } = Astro.props;
---
<ul class="fondos" style={`--fo-line:${line}`}>
  {fondos.map((f) => (
    <li>
      <figure class="fondo">
        <img
          class="fondo__img"
          src={url(`${dir}/${f.slug}.svg`)}
          alt=""
          width="1080"
          height="1920"
          loading="lazy"
          decoding="async"
        />
        <figcaption class="fondo__nm"><b>{String(f.n).padStart(2, '0')}</b>{f.name}</figcaption>
      </figure>
    </li>
  ))}
</ul>

<style>
  .fondos { display: grid; grid-template-columns: repeat(auto-fill, minmax(116px, 1fr)); gap: var(--s-5) var(--s-3); }
  .fondo { min-width: 0; }
  /* Filete por encima del SVG: un box-shadow interior queda tapado por la imagen. */
  .fondo__img { width: 100%; height: auto; aspect-ratio: 9 / 16; object-fit: cover; outline: 1px solid var(--fo-line); outline-offset: -1px; }
  .fondo__nm { display: grid; grid-template-columns: 1.6rem 1fr; gap: var(--s-1); margin-top: var(--s-2); font-size: 0.75rem; line-height: 1.3; overflow-wrap: anywhere; }
  .fondo__nm b { font-weight: 500; color: var(--fg-2); font-variant-numeric: tabular-nums; }
  @media (max-width: 599px) { .fondos { grid-template-columns: repeat(auto-fill, minmax(88px, 1fr)); } }
</style>
