---
/* Tarjeta de proyecto: la lámina de portada y, debajo, el pie con el tipo de
   trabajo y el cliente. Toda la tarjeta es el enlace. */
import type { Project } from '../data/projects';
import Portada from './Portada.astro';
import { url } from '../lib/assets';

interface Props { project: Project }
const { project: p } = Astro.props;
---
<a class="card" href={url(`trabajo/${p.slug}/`)}>
  <span class="card__plate" style={`view-transition-name: t-${p.slug}`}><Portada slug={p.slug} rotulo={p.format.name} /></span>
  <span class="card__body">
    {/* La lámina es decorativa para el lector de pantalla: el nombre del proyecto va aquí. */}
    <span class="sr-only">{p.title}.</span>
    <span class="card__kind">{p.category}</span>
    <span class="card__meta">{p.client}, {p.year}</span>
  </span>
</a>

<style>
  .card { display: flex; flex-direction: column; height: 100%; text-decoration: none; }
  /* La lámina llena la placa: es la portada completa, nunca un recorte. */
  .card__plate { display: block; aspect-ratio: 4 / 3; overflow: hidden; background: var(--plate); }
  .card__plate :global(svg) { width: 100%; height: 100%; transition: transform 600ms var(--ease-out); }
  /* El nombre del proyecto lo pone la lámina; abajo solo queda el pie: tipo de trabajo y cliente. */
  .card__body { display: grid; gap: 0.125rem; padding-top: var(--s-4); }
  .card__kind { font-size: 0.9375rem; }
  .card__meta { font-size: var(--t-small); color: var(--fg-2); }
  @media (hover: hover) and (pointer: fine) {
    .card:hover .card__plate :global(svg) { transform: scale(1.02); }
    .card:hover .card__kind { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.2em; }
  }
</style>
