---
/* Tarjeta de proyecto: portada compuesta, título, tipo y cliente. Toda la tarjeta es el enlace. */
import ProjectCover from './ProjectCover.astro';
import type { Project } from '../data/projects';
import { url } from '../lib/assets';

interface Props { project: Project; eager?: boolean }
const { project: p, eager = false } = Astro.props;
---
<a class="card" href={url(`trabajo/${p.slug}/`)}>
  <span class="card__plate">
    <ProjectCover portada={p.portada} eager={eager} />
  </span>
  <span class="card__body">
    <span class="card__kind">{p.category}</span>
    <span class="card__title" style={`view-transition-name: t-${p.slug}`}>{p.title}</span>
    <span class="card__meta">{p.client}, {p.year}</span>
  </span>
</a>

<style>
  .card { display: flex; flex-direction: column; height: 100%; text-decoration: none; }
  .card__plate { display: block; overflow: hidden; background: var(--plate); }
  .card__plate :global(.pc) { transition: transform 600ms var(--ease-out); }
  .card__body { display: grid; gap: 0.125rem; padding-top: var(--s-4); }
  .card__kind { font-size: var(--t-small); color: var(--fg-2); }
  .card__title { font-family: var(--display); font-weight: var(--display-w); letter-spacing: -0.01em; font-size: clamp(1.5rem, 1.25rem + 0.7vw, 1.875rem); line-height: 1.1; }
  .card__meta { font-size: var(--t-small); color: var(--fg-2); }
  @media (hover: hover) and (pointer: fine) {
    .card:hover .card__plate :global(.pc) { transform: scale(1.02); }
    .card:hover .card__title { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.2em; }
  }
</style>
